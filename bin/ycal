#!/usr/bin/env node
// yCal CLI client — talks to the running yCal GUI via a Unix socket so
// invocations don't bounce a second Electron process and flash the dock.
//
// Flow:
//   1. Try to connect to ~/Library/Application Support/yCal/cli.sock.
//      If it answers → print response → exit. (~50ms, no dock activity.)
//   2. If the socket never accepts, the GUI isn't running: launch yCal.app
//      via `open -g -a` (no focus steal), poll the socket for up to 15s,
//      then drive it once it's up. Subsequent calls go through path 1.
//   3. If the socket DID accept but the request didn't finish (timeout, or
//      the connection dropped mid-answer), the GUI is up — say so and stop.
//      Launching a second copy would neither help nor be honest.
//   4. If yCal.app isn't installed, fail with code 2.
//
// Pure Node, no Electron import — that's what keeps the dock quiet.
'use strict';

const net = require('node:net');
const path = require('node:path');
const fs = require('node:fs');
const os = require('node:os');
const { spawn } = require('node:child_process');

const APP_PATH = '/Applications/yCal.app';
const APP_BIN = path.join(APP_PATH, 'Contents/MacOS/yCal');
// app.name resolves to "ycal" (the package.json name field) — that's the
// real userData dir name. macOS's default APFS volume is case-insensitive
// so "yCal" works too, but match the real path for case-sensitive volumes.
const SOCK = path.join(
  os.homedir(),
  'Library/Application Support/ycal/cli.sock',
);
const args = process.argv.slice(2);

// Mirror the command-discovery part of main/cli.ts so an argument value such
// as `ycal find update` does not accidentally opt into the streaming updater
// protocol. Flags may appear before the command.
function findCommand(argv) {
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h' || arg === '--version' || arg === '-v') {
      i++;
      continue;
    }
    if (arg.startsWith('--')) {
      if (arg.includes('=')) {
        i++;
      } else if (argv[i + 1] !== undefined && !argv[i + 1].startsWith('--')) {
        i += 2;
      } else {
        i++;
      }
      continue;
    }
    return arg;
  }
  return '';
}

const command = findCommand(args);
const isUpdateCommand = command === 'update' || command === 'upgrade';
// Updating can download a large release zip before the app hands off to the
// swap helper. Keep the normal request budget short, but allow self-update
// enough time on a slow connection.
const DEFAULT_READ_TIMEOUT_MS = 30000;
const UPDATE_READ_TIMEOUT_MS = 10 * 60 * 1000;

// Floor for the override. Below this the budget can expire on a perfectly
// healthy request — the fast path already spends up to 1s on connect alone,
// and normal commands need a Google Calendar roundtrip on top. That failure
// classifies as 'timeout', not 'unreachable', so it would never fall through
// to launching the GUI: the CLI would just refuse every command with a
// "connected, but…" message. 5s is 5× the connect budget and comfortably
// past the couple-second roundtrip, so it only rejects values that are
// unusable by construction.
const MIN_READ_TIMEOUT_MS = 5000;

// Opt-in escape hatch, not a bigger default. A request that needs more than
// 30s is a real symptom (an archive listing that has outgrown the budget),
// and quietly waiting longer would hide it — so the default stays put and
// the timeout message names this variable instead. The override can only
// RAISE `update`'s 10-minute budget, and can never take any command below
// MIN_READ_TIMEOUT_MS — a stale `export YCAL_TIMEOUT_MS=2000` left in a
// shell profile after one update must not quietly break every later call.
function readTimeoutOverride() {
  const raw = process.env.YCAL_TIMEOUT_MS;
  if (raw === undefined || raw.trim() === '') return null;
  const ms = Number(raw);
  if (!Number.isFinite(ms) || ms <= 0) {
    process.stderr.write(
      `ycal: ignoring YCAL_TIMEOUT_MS=${raw} — expected a positive number of milliseconds\n`,
    );
    return null;
  }
  return Math.round(ms);
}

const timeoutOverride = readTimeoutOverride();
const readTimeoutMs = isUpdateCommand
  ? Math.max(UPDATE_READ_TIMEOUT_MS, timeoutOverride ?? 0)
  : Math.max(MIN_READ_TIMEOUT_MS, timeoutOverride ?? DEFAULT_READ_TIMEOUT_MS);
let progressVisible = false;

function renderProgress(status) {
  if (!process.stderr.isTTY) return;
  let label = 'Checking for updates';
  let percent = null;
  if (status.state === 'available') {
    label = `Downloading yCal ${status.version ?? ''}`.trim();
    percent = status.progress ?? 0;
  } else if (status.state === 'ready') {
    label = `Downloaded yCal ${status.version ?? ''}`.trim();
    percent = 100;
  } else if (status.state === 'installing') {
    label = `Installing yCal ${status.version ?? ''}`.trim();
    percent = status.progress ?? 0;
  } else if (status.state === 'error') {
    label = 'Update failed';
  }

  const width = 24;
  const clamped = percent == null ? null : Math.max(0, Math.min(100, percent));
  const filled = clamped == null ? 0 : Math.round((clamped / 100) * width);
  const bar = percent == null
    ? '[························]'
    : `[${'='.repeat(filled)}${' '.repeat(width - filled)}]`;
  const suffix = clamped == null ? '' : ` ${String(Math.round(clamped)).padStart(3)}%`;
  process.stderr.write(`\r\u001b[2K${label} ${bar}${suffix}`);
  progressVisible = true;
}

function finishProgress() {
  if (!progressVisible) return;
  process.stderr.write('\n');
  progressVisible = false;
}

// Split timeouts on purpose:
//   • connectTimeoutMs caps how long we wait for the GUI to accept the
//     socket. Short — if it can't accept in <1s the GUI almost certainly
//     isn't running, and we should fall back to launching.
//   • readTimeoutMs caps the actual request. Generous, since real commands
//     hit the Google Calendar API and can take a couple seconds.
//
// Resolves with a tagged outcome rather than a bare response-or-null,
// because the caller has to tell two very different failures apart:
//   { outcome: 'ok', result }      → response parsed, print it
//   { outcome: 'unreachable' }     → the socket never accepted; GUI is down
//   { outcome: 'timeout' }         → accepted, then nothing within the budget
//   { outcome: 'unusable', detail} → accepted, then closed/errored with no
//                                    parseable response
// Collapsing the last three into null is what made a slow request print
// "yCal not running — launching…" and then launch an app that was already
// running.
const UNREACHABLE = { outcome: 'unreachable' };

function tryRequest(connectTimeoutMs, readTimeoutMs) {
  return new Promise((resolve) => {
    const sock = net.createConnection(SOCK);
    let connected = false;
    let settled = false;
    let buf = '';
    let lineBuf = '';

    // Several socket events can fire for one failure (error then close);
    // first one wins, the rest are no-ops.
    const settle = (value) => {
      if (settled) return;
      settled = true;
      resolve(value);
    };

    const connectTimer = setTimeout(() => {
      sock.destroy();
      settle(UNREACHABLE);
    }, connectTimeoutMs);
    let readTimer = null;

    sock.setEncoding('utf8');
    sock.on('connect', () => {
      connected = true;
      clearTimeout(connectTimer);
      sock.write(JSON.stringify({ args, stream: isUpdateCommand }));
      sock.end(); // half-close: server reads until 'end'
      readTimer = setTimeout(() => {
        sock.destroy();
        settle({ outcome: 'timeout' });
      }, readTimeoutMs);
    });
    sock.on('data', (chunk) => {
      if (!isUpdateCommand) {
        buf += chunk;
        return;
      }
      lineBuf += chunk;
      let newline = lineBuf.indexOf('\n');
      while (newline >= 0) {
        const line = lineBuf.slice(0, newline);
        lineBuf = lineBuf.slice(newline + 1);
        try {
          const frame = JSON.parse(line);
          if (frame.type === 'progress') renderProgress(frame.status);
          else if (frame.type === 'result') buf = JSON.stringify(frame);
        } catch (_e) { /* ignore malformed progress frame */ }
        newline = lineBuf.indexOf('\n');
      }
    });
    sock.on('end', () => {
      clearTimeout(connectTimer);
      if (readTimer) clearTimeout(readTimer);
      try {
        if (isUpdateCommand && !buf && lineBuf) {
          // Backwards compatibility with an older installed yCal that
          // answers with the original single-JSON response.
          buf = lineBuf;
        }
        const parsed = JSON.parse(buf);
        settle({
          outcome: 'ok',
          result: parsed.type === 'result'
            ? { stdout: parsed.stdout, stderr: parsed.stderr, code: parsed.code }
            : parsed,
        });
      } catch (_e) {
        settle({
          outcome: 'unusable',
          detail: buf ? 'response was not valid JSON' : 'response was empty',
        });
      }
    });
    sock.on('error', (err) => {
      clearTimeout(connectTimer);
      if (readTimer) clearTimeout(readTimer);
      // ENOENT (no socket) and ECONNREFUSED (stale socket, nobody listening)
      // land here BEFORE 'connect' — that, and only that, means the GUI isn't
      // accepting requests, so main() should fall back to launching it. An
      // error after 'connect' is a live GUI that dropped the call; it used to
      // leave this promise pending forever, hanging the CLI.
      settle(connected
        ? { outcome: 'unusable', detail: (err && err.message) || String(err) }
        : UNREACHABLE);
    });
    // Backstop: a close with neither 'end' nor 'error' would otherwise hang.
    sock.on('close', () => {
      clearTimeout(connectTimer);
      if (readTimer) clearTimeout(readTimer);
      settle(connected
        ? { outcome: 'unusable', detail: 'connection closed before a response arrived' }
        : UNREACHABLE);
    });
  });
}

function deliver(res) {
  finishProgress();
  const code = typeof res.code === 'number' ? res.code : 0;
  if (res.stderr) process.stderr.write(res.stderr);
  // Wait for stdout to drain before exiting — process.exit() with a large
  // piped stdout (> ~64KB) would truncate the output otherwise.
  if (res.stdout) {
    process.stdout.write(res.stdout, () => process.exit(code));
  } else {
    process.exit(code);
  }
}

function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

// Quote an argv entry well enough that the suggested retry line can be
// pasted back into a shell verbatim.
function shellQuote(a) {
  return /^[\w@%+=:,./-]+$/.test(a) ? a : `'${String(a).replace(/'/g, "'\\''")}'`;
}

function describeCommand() {
  return command ? `\`ycal ${command}\`` : 'the request';
}

// The socket accepted, so a yCal process is alive holding that listener —
// this must never claim otherwise or launch a second copy. But "alive" is
// the ONLY thing a completed connect proves. A wedged main process still has
// its listener, so the kernel accepts and we time out exactly as we do on a
// merely-slow request; the two are indistinguishable from here. Say what was
// observed, offer both readings, and never tell the user to sit through a
// longer wait as if it were the certain fix.
function reportLiveFailure(attempt) {
  finishProgress();
  if (attempt.outcome === 'timeout') {
    const secs = readTimeoutMs / 1000;
    // Don't round a 1.5s override up to "2s" — the number is the whole point.
    const budget = `${secs >= 10 ? Math.round(secs) : Math.round(secs * 10) / 10}s`;
    const suggested = Math.max(readTimeoutMs * 3, 120000);
    const retry = ['ycal', ...args.map(shellQuote)].join(' ');
    process.stderr.write(
      `ycal: connected to yCal, but ${describeCommand()} did not answer within ${budget}.\n`
      + '  The socket accepted, so yCal is up — it is either slow to answer this\n'
      + '  command (listings of the whole Drive archive get slower as it grows) or\n'
      + '  stuck. This cannot tell the two apart.\n'
      + `  If you think it is slow, give this one call more room:\n    YCAL_TIMEOUT_MS=${suggested} ${retry}\n`
      + '  If that times out too, or it keeps happening, restart yCal.\n',
    );
  } else {
    process.stderr.write(
      `ycal: connected to yCal, but ${describeCommand()} returned no usable response`
      + `${attempt.detail ? ` (${attempt.detail})` : ''}.\n`
      + '  yCal is running. Retry; if it repeats, restart yCal.\n',
    );
  }
  process.exit(1);
}

async function main() {
  // Fast path: GUI already running. Short connect, long read — most commands
  // need a network roundtrip to Google Calendar, which can take a couple
  // seconds.
  let attempt = await tryRequest(1000, readTimeoutMs);
  if (attempt.outcome === 'ok') return deliver(attempt.result);
  // Anything but 'unreachable' means the socket accepted us, i.e. the GUI is
  // alive. Don't fall through to the launch path.
  if (attempt.outcome !== 'unreachable') return reportLiveFailure(attempt);

  // Slow path: the socket never accepted. Launch the GUI, then poll.
  if (!fs.existsSync(APP_BIN)) {
    process.stderr.write(
      `ycal: yCal.app not found at ${APP_PATH}. ` +
        'Install it from a release on https://github.com/yehzu/ycal\n',
    );
    process.exit(2);
  }
  process.stderr.write('yCal not running — launching…\n');
  // -g: launch without bringing yCal to the foreground. CLI calls often come
  // from background agents/scripts; stealing focus from whatever the user is
  // doing is never what they want. Also matters when the GUI *is* running but
  // the socket didn't answer in time — plain `open -a` would activate it.
  const proc = spawn('/usr/bin/open', ['-g', '-a', APP_PATH], {
    stdio: 'ignore',
    detached: true,
  });
  proc.unref();

  // Poll the socket for up to 15s. The GUI usually accepts requests within
  // 1–3s of launch on a warm machine; cold start with auth refresh can take
  // longer.
  const deadline = Date.now() + 15000;
  while (Date.now() < deadline) {
    await sleep(300);
    attempt = await tryRequest(700, readTimeoutMs);
    if (attempt.outcome === 'ok') return deliver(attempt.result);
    // The GUI came up and accepted, but the request itself failed. Report
    // that instead of polling out the remaining seconds and blaming startup.
    if (attempt.outcome !== 'unreachable') return reportLiveFailure(attempt);
  }
  process.stderr.write('ycal: timed out waiting for yCal to start (15s)\n');
  process.exit(1);
}

main().catch((e) => {
  process.stderr.write(`ycal: ${e instanceof Error ? e.stack || e.message : String(e)}\n`);
  process.exit(1);
});
