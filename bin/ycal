#!/usr/bin/env node
// yCal CLI client — talks to the running yCal GUI via a Unix socket so
// invocations don't bounce a second Electron process and flash the dock.
//
// Flow:
//   1. Try to connect to ~/Library/Application Support/yCal/cli.sock.
//      If it answers → print response → exit. (~50ms, no dock activity.)
//   2. If the GUI isn't running, launch yCal.app via `open -g -a` (no focus
//      steal), poll the socket for up to 15s, then drive it once it's up.
//      Subsequent calls go straight through path 1.
//   3. If yCal.app isn't installed, fail with code 2.
//
// Pure Node, no Electron import — that's what keeps the dock quiet.
'use strict';

const net = require('node:net');
const path = require('node:path');
const fs = require('node:fs');
const os = require('node:os');
const { spawn } = require('node:child_process');

const APP_PATH = '/Applications/yCal.app';
const APP_BIN = path.join(APP_PATH, 'Contents/MacOS/yCal');
// app.name resolves to "ycal" (the package.json name field) — that's the
// real userData dir name. macOS's default APFS volume is case-insensitive
// so "yCal" works too, but match the real path for case-sensitive volumes.
const SOCK = path.join(
  os.homedir(),
  'Library/Application Support/ycal/cli.sock',
);
const args = process.argv.slice(2);

// Mirror the command-discovery part of main/cli.ts so an argument value such
// as `ycal find update` does not accidentally opt into the streaming updater
// protocol. Flags may appear before the command.
function findCommand(argv) {
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h' || arg === '--version' || arg === '-v') {
      i++;
      continue;
    }
    if (arg.startsWith('--')) {
      if (arg.includes('=')) {
        i++;
      } else if (argv[i + 1] !== undefined && !argv[i + 1].startsWith('--')) {
        i += 2;
      } else {
        i++;
      }
      continue;
    }
    return arg;
  }
  return '';
}

const command = findCommand(args);
const isUpdateCommand = command === 'update' || command === 'upgrade';
// Updating can download a large release zip before the app hands off to the
// swap helper. Keep the normal request budget short, but allow self-update
// enough time on a slow connection.
const readTimeoutMs =
  isUpdateCommand ? 10 * 60 * 1000 : 30000;
let progressVisible = false;

function renderProgress(status) {
  if (!process.stderr.isTTY) return;
  let label = 'Checking for updates';
  let percent = null;
  if (status.state === 'available') {
    label = `Downloading yCal ${status.version ?? ''}`.trim();
    percent = status.progress ?? 0;
  } else if (status.state === 'ready') {
    label = `Downloaded yCal ${status.version ?? ''}`.trim();
    percent = 100;
  } else if (status.state === 'installing') {
    label = `Installing yCal ${status.version ?? ''}`.trim();
    percent = status.progress ?? 0;
  } else if (status.state === 'error') {
    label = 'Update failed';
  }

  const width = 24;
  const clamped = percent == null ? null : Math.max(0, Math.min(100, percent));
  const filled = clamped == null ? 0 : Math.round((clamped / 100) * width);
  const bar = percent == null
    ? '[························]'
    : `[${'='.repeat(filled)}${' '.repeat(width - filled)}]`;
  const suffix = clamped == null ? '' : ` ${String(Math.round(clamped)).padStart(3)}%`;
  process.stderr.write(`\r\u001b[2K${label} ${bar}${suffix}`);
  progressVisible = true;
}

function finishProgress() {
  if (!progressVisible) return;
  process.stderr.write('\n');
  progressVisible = false;
}

// Split timeouts on purpose:
//   • connectTimeoutMs caps how long we wait for the GUI to accept the
//     socket. Short — if it can't accept in <1s the GUI almost certainly
//     isn't running, and we should fall back to launching.
//   • readTimeoutMs caps the actual request. Generous, since real commands
//     hit the Google Calendar API and can take a couple seconds. A single
//     unified timeout caused responses to be cut off mid-flight on slower
//     queries and produced false "yCal not running" reports.
function tryRequest(connectTimeoutMs, readTimeoutMs) {
  return new Promise((resolve) => {
    const sock = net.createConnection(SOCK);
    let connected = false;
    let buf = '';
    let lineBuf = '';

    const connectTimer = setTimeout(() => {
      sock.destroy();
      resolve(null);
    }, connectTimeoutMs);
    let readTimer = null;

    sock.setEncoding('utf8');
    sock.on('connect', () => {
      connected = true;
      clearTimeout(connectTimer);
      sock.write(JSON.stringify({ args, stream: isUpdateCommand }));
      sock.end(); // half-close: server reads until 'end'
      readTimer = setTimeout(() => {
        sock.destroy();
        resolve(null);
      }, readTimeoutMs);
    });
    sock.on('data', (chunk) => {
      if (!isUpdateCommand) {
        buf += chunk;
        return;
      }
      lineBuf += chunk;
      let newline = lineBuf.indexOf('\n');
      while (newline >= 0) {
        const line = lineBuf.slice(0, newline);
        lineBuf = lineBuf.slice(newline + 1);
        try {
          const frame = JSON.parse(line);
          if (frame.type === 'progress') renderProgress(frame.status);
          else if (frame.type === 'result') buf = JSON.stringify(frame);
        } catch (_e) { /* ignore malformed progress frame */ }
        newline = lineBuf.indexOf('\n');
      }
    });
    sock.on('end', () => {
      clearTimeout(connectTimer);
      if (readTimer) clearTimeout(readTimer);
      try {
        if (isUpdateCommand && !buf && lineBuf) {
          // Backwards compatibility with an older installed yCal that
          // answers with the original single-JSON response.
          buf = lineBuf;
        }
        const parsed = JSON.parse(buf);
        resolve(parsed.type === 'result'
          ? { stdout: parsed.stdout, stderr: parsed.stderr, code: parsed.code }
          : parsed);
      } catch (_e) {
        resolve(null);
      }
    });
    sock.on('error', () => {
      clearTimeout(connectTimer);
      if (readTimer) clearTimeout(readTimer);
      // ENOENT (no socket) and ECONNREFUSED (stale socket, nobody listening)
      // both land here. Returning null tells main() to fall back to launching
      // the GUI.
      if (!connected) resolve(null);
    });
  });
}

function deliver(res) {
  finishProgress();
  const code = typeof res.code === 'number' ? res.code : 0;
  if (res.stderr) process.stderr.write(res.stderr);
  // Wait for stdout to drain before exiting — process.exit() with a large
  // piped stdout (> ~64KB) would truncate the output otherwise.
  if (res.stdout) {
    process.stdout.write(res.stdout, () => process.exit(code));
  } else {
    process.exit(code);
  }
}

function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

async function main() {
  // Fast path: GUI already running. Short connect, long read — most commands
  // need a network roundtrip to Google Calendar, which can take a couple
  // seconds.
  let res = await tryRequest(1000, readTimeoutMs);
  if (res) return deliver(res);

  // Slow path: launch the GUI, then poll.
  if (!fs.existsSync(APP_BIN)) {
    process.stderr.write(
      `ycal: yCal.app not found at ${APP_PATH}. ` +
        'Install it from a release on https://github.com/yehzu/ycal\n',
    );
    process.exit(2);
  }
  process.stderr.write('yCal not running — launching…\n');
  // -g: launch without bringing yCal to the foreground. CLI calls often come
  // from background agents/scripts; stealing focus from whatever the user is
  // doing is never what they want. Also matters when the GUI *is* running but
  // the socket didn't answer in time — plain `open -a` would activate it.
  const proc = spawn('/usr/bin/open', ['-g', '-a', APP_PATH], {
    stdio: 'ignore',
    detached: true,
  });
  proc.unref();

  // Poll the socket for up to 15s. The GUI usually accepts requests within
  // 1–3s of launch on a warm machine; cold start with auth refresh can take
  // longer.
  const deadline = Date.now() + 15000;
  while (Date.now() < deadline) {
    await sleep(300);
    res = await tryRequest(700, readTimeoutMs);
    if (res) return deliver(res);
  }
  process.stderr.write('ycal: timed out waiting for yCal to start (15s)\n');
  process.exit(1);
}

main().catch((e) => {
  process.stderr.write(`ycal: ${e instanceof Error ? e.stack || e.message : String(e)}\n`);
  process.exit(1);
});
